# Copy to .env and fill in. .env is gitignored; never commit real keys.
# In GitHub Actions these live in Settings -> Secrets -> Actions instead.

# --- Required for Slack alerts -------------------------------------------
# Slack -> Apps -> Incoming Webhooks -> Add to a channel -> copy URL
SLACK_WEBHOOK_URL=

# --- Free, no payment required -------------------------------------------
# FRED: key is free with registration. Used for HY OAS, yield curve, Sahm,
# NFCI, claims. CSV download works without a key; the key raises rate limits.
FRED_API_KEY=

# SEC EDGAR requires no key but DOES require a descriptive User-Agent with a
# contact address, or it blocks you. Not optional.
SEC_USER_AGENT=SmartTrades research you@example.com

# These need no key at all and carry the whole free stack:
#   cdn.finra.org              off-exchange volume
#   stooq.com                  EOD OHLCV
#   api.binance.com            BTC candles
#   community-api.coinmetrics.io   BTC market cap + MVRV
#   house/senate-stock-watcher-data.s3...  parsed PTRs
#   feeds.finance.yahoo.com    news RSS
#
# FINRA's ATS transparency API needs OAuth credentials, free on registration.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# --- OPTIONAL. The free stack runs without any of these. -----------------
# run_all.py binds every loader to engines/free_sources.py by default.
# Only two are worth buying later, and only after the pipeline proves itself:
#   GLASSNODE  ~$39/mo  restores STH-MVRV (the one real gap)
#   SHARADAR  ~$150/mo  saves the EDGAR normalisation work, not better data
FMP_API_KEY=
EODHD_API_KEY=
NASDAQ_DATA_LINK_KEY=

# Price and volume. Polygon has a free tier (5 req/min, EOD only).
POLYGON_API_KEY=
TIINGO_API_KEY=

# On-chain: STH-MVRV and MVRV Z-Score. No reliable free source exists.
GLASSNODE_API_KEY=

# Congressional disclosures. Free alternative: House/Senate Stock Watcher JSON.
QUIVER_API_KEY=

# News. All three have free tiers usable for a personal dashboard.
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
ALPHAVANTAGE_API_KEY=
